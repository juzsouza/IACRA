# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE_KEY: Supabase anon key
# Required for database access
SUPABASE_KEY="YOUR_SUPABASE_KEY"

# SUPABASE_SECRET_KEY: Supabase service_role / administrative secret key (server-side only)
SUPABASE_SECRET_KEY=

# Google Calendar Integration (Optional)
# Configure in Google Cloud Console with OAuth 2.0 Client ID (Web Application)
# Scope: https://www.googleapis.com/auth/calendar.events.owned, https://www.googleapis.com/auth/userinfo.email
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="https://ais-pre-dtbuosbavtkbqwldnldzbe-39716750309.us-east1.run.app/api/google/oauth/callback"

