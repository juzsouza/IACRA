    "test:google": "tsx src/tests/google_calendar_integration.test.ts",
    "test:resilience": "tsx src/tests/google_calendar_resilience.test.ts",
    "test:access": "tsx src/tests/auth_admin_access_toggle.test.ts",
    "test:retention": "tsx src/tests/navigation_view_retention.test.ts",
    "test:reminders": "tsx src/tests/google_calendar_reminders.test.ts",
    "test:cache-sw": "tsx src/tests/cache_and_service_worker_migration.test.ts",
    "test:oauth-prod": "tsx src/tests/google_calendar_oauth_production.test.ts",
    "test:inbound": "tsx src/tests/google_calendar_inbound.test.ts",
    "test:teachers": "tsx src/tests/teachers_resilience_and_specialties_null.test.ts",
    "test:asheley": "tsx src/tests/asheley_and_active_enrollments_billing.test.ts"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
